# Copy to .env and adjust. .env is git- and docker-ignored; never put real keys in this file.
DATA_DIR=./data
# true = no network at all: OSINT answers come only from data/cache/osint.sqlite (demo default)
OFFLINE=true
HTTP_TIMEOUT_S=10

# Optional LLM (narrative classification). Everything works without it.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Path to the Tesseract binary (visual OCR). Leave empty to use `tesseract` from PATH
# (macOS: brew install tesseract tesseract-lang; Docker/Linux: apt-get install tesseract-ocr tesseract-ocr-pol).
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Text embeddings off (faster runs, text_emb = None)
TEXT_EMB_DISABLED=

# --- Docker only ---
# Host user that owns ./data (Linux: run `id -u` / `id -g`). Docker Desktop ignores this.
UID=1000
GID=1000
# Optional Neo4j (profile "graph"); minimum 8 characters
NEO4J_PASSWORD=fakecollector-demo

# Override model directory (default: data/models). Local runs only: the Docker
# containers always use /models (pinned in docker-compose.yml).
MODELS_DIR=
